ctive":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":660,"y":520,"wires":[]},{"id":"e44ef7a9369f54bb","type":"catch","z":"d3aaf91ef35b1c30","name":"","scope":["9a399cf30c4d3511"],"uncaught":false,"x":450,"y":480,"wires":[["d3d0231b934b995b"]]},{"id":"d3d0231b934b995b","type":"debug","z":"d3aaf91ef35b1c30","name":"Errori lettura","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":630,"y":480,"wires":[]},{"id":"8cc915ae4f773059","type":"function","z":"d3aaf91ef35b1c30","name":"Prepara dati batch","func":"const counter = context.get(\"counter\") || 0;\ncontext.set(\"counter\", counter + 1);\n\n// Genera dati multipli per il batch\nconst timestamp = new Date();\nconst baseValue = Math.random() * 100;\n\nmsg.payload = [\n    {\n        measurement: \"SensorBatch\",\n        fields: {\n            temperatura: (baseValue + Math.random() * 10).toFixed(2),\n            umidita: Math.floor(Math.random() * 100),\n            pressione: (1013 + Math.random() * 50).toFixed(1),\n            counter: counter\n        },\n        tags: {\n            location: \"sala_server\",\n            sensor_id: \"sensor_001\",\n            tipo: \"ambiente\"\n        },\n        timestamp: timestamp\n    },\n    {\n        measurement: \"SensorBatch\",\n        fields: {\n            temperatura: (baseValue + Math.random() * 15).toFixed(2),\n            umidita: Math.floor(Math.random() * 100),\n            pressione: (1013 + Math.random() * 30).toFixed(1),\n            counter: counter\n        },\n        tags: {\n            location: \"ufficio\",\n            sensor_id: \"sensor_002\",\n            tipo: \"ambiente\"\n        },\n        timestamp: new Date(timestamp.getTime() + 1000) // +1 secondo\n    },\n    {\n        measurement: \"SystemBatch\",\n        fields: {\n            cpu_usage: Math.floor(Math.random() * 100),\n            memory_usage: Math.floor(Math.random() * 100),\n            disk_usage: Math.floor(Math.random() * 100),\n            network_traffic: Math.floor(Math.random() * 1000),\n            counter: counter\n        },\n        tags: {\n            server: \"VM-113-D11\",\n            datacenter: \"DC1\",\n            tipo: \"sistema\"\n        },\n        timestamp: new Date(timestamp.getTime() + 2000) // +2 secondi\n    }\n];\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"// Inizializza il contatore\ncontext.set(\"counter\", 0);","finalize":"","libs":[],"x":590,"y":160,"wires":[["343fe53c6ed65af4","38faa2f741145146"]]},{"id":"0508e22d51018e6a","type":"inject","z":"d3aaf91ef35b1c30","name":"Test Influx","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":160,"y":160,"wires":[["a86c66fc6737f956"]]},{"id":"a86c66fc6737f956","type":"trigger","z":"d3aaf91ef35b1c30","name":"","op1":"","op2":"","op1type":"date","op2type":"date","duration":"-10","extend":false,"overrideDelay":false,"units":"s","reset":"","bytopic":"all","topic":"topic","outputs":1,"x":370,"y":160,"wires":[["8cc915ae4f773059"]]},{"id":"3be79075e4f9c6f0","type":"inject","z":"d3aaf91ef35b1c30","name":"Ferma test","props":[{"p":"reset","v":"true","vt":"bool"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","x":160,"y":200,"wires":[["a86c66fc6737f956"]]},{"id":"343fe53c6ed65af4","type":"influxdb batch","z":"d3aaf91ef35b1c30","influxdb":"f2f4cd01165e9471","precision":"ms","retentionPolicy":"","name":"Batch Writer","database":"","retentionPolicyV18Flux":"","org":"GEM","bucket":"db0","x":830,"y":180,"wires":[]},{"id":"38faa2f741145146","type":"debug","z":"d3aaf91ef35b1c30","name":"DEBUG Batch Data","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":850,"y":140,"wires":