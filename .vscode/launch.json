{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Node-RED with InfluxDB nodes",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/node-red/red.js",
            "args": [
                "--userDir", "${workspaceFolder}\\.node-red-dev",
                "--verbose"
            ],
            "console": "integratedTerminal",
            "env": {
                "NODE_ENV": "development",
                "DEBUG": "influx*",
                "IDB_ENABLED": "false",
                "IDB_VERSION": "2",
                "IDB_URL": "http://10.0.1.253:8086",
                "IDB_ORG": "GEM",
                "IDB_BUCKET": "db0",
                "IDB_TOKEN": "j8hLNwtnJCowYISRVut3eM5rOqThUy2mkBeK3KRYxtc2yoW2i9L554ZprPr6Y8YUtATFHAvEUs81a5YtNC9zhQ=="
            },
            "skipFiles": [
                "<node_internals>/**"
            ],
            "restart": true,
            "runtimeArgs": ["--inspect=9229"],
            "outputCapture": "std"
        },
        {
            "name": "Attach to Node-RED",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}