{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Node-RED - InfluxDB 1.0",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/node-red/red.js",
            "args": [
                "--userDir", "${workspaceFolder}\\.node-red-dev",
                "--verbose"
            ],
            "console": "integratedTerminal",
            "env": {
                "NODE_ENV": "development",
                "DEBUG": "influx*",
                "IDB_ENABLED": "true",
                "IDB_VERSION": "1",
                "IDB_HOSTNAME_1X": "10.0.0.114",
                "IDB_PORT_1X": "8085",
                "IDB_DATABASE_1X": "testdb",
                "IDB_USERNAME_1X": "admin",
                "IDB_PASSWORD_1X": "password123"
            },
            "skipFiles": [
                "<node_internals>/**"
            ],
            "restart": true,
            "runtimeArgs": ["--inspect=9229"],
            "outputCapture": "std"
        },
        {
            "name": "Debug Node-RED - InfluxDB 1.8-Flux",
