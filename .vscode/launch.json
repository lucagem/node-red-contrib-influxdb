                "IDB_URL_18_FLUX": "http://10.0.0.114:8086",
                "IDB_USERNAME_18_FLUX": "admin",
                "IDB_PASSWORD_18_FLUX": "password123"
            },
            "skipFiles": [
                "<node_internals>/**"
            ],
